# ============================================================
# ward-duty environment variables
# 운영 위치: ~/docker/ward-duty/.env (홈서버)
# ============================================================

PROJECT_NAME=ward-duty

# --- PostgreSQL (shared-postgres) ---
DB_HOST=shared-postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=                              # 공유 인프라 비밀번호 (51.01 인프라 레퍼런스 참조)
DB_NAME=ward_duty
DB_SSLMODE=disable

# --- Redis (ward-duty 전용) ---
REDIS_HOST=ward-duty-redis:6379
REDIS_PASSWORD=                           # openssl rand -hex 32

# --- JWT ---
JWT_SECRET=                               # openssl rand -hex 64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h                      # 7d

# --- Google OAuth (FR-10) ---
GOOGLE_CLIENT_ID=                         # Google Cloud Console > Credentials > OAuth 2.0 Client ID
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URL=https://ward-duty.dltmxm.link/api/auth/oauth/google/callback
OAUTH_STATE_SECRET=                       # openssl rand -hex 32 (state·nonce·PKCE 서명)
ADMIN_EMAIL=                              # 첫 로그인 시 자동으로 head_nurse 권한이 부여될 이메일

# --- Solver (internal-only) ---
SOLVER_URL=http://ward-duty-solver:8000
SOLVER_INTERNAL_TOKEN=                    # openssl rand -hex 32  (api ↔ solver 인증)
SOLVER_TIMEOUT_SECONDS=300                # 솔버 호출 전체 timeout (max_time_seconds=55의 여유)

# --- Web ---
NEXT_PUBLIC_API_URL=/api                  # 단일 도메인이라 상대 경로

# --- 로깅 ---
LOG_LEVEL=info                            # debug | info | warn | error
